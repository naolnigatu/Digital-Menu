rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is super admin
    function isSuperAdmin() {
      let docRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'naolnigatu2025@gmail.com') ||
        (exists(docRef) && get(docRef).data.get('role', '') == 'super_admin')
      );
    }

    // Function to get user's tenantId
    function getUserTenantId() {
      let docRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docRef) ? get(docRef).data.get('tenantId', null) : null;
    }
    
    function getStaffTenantId() {
      let docRef = /databases/$(database)/documents/staff/$(request.auth.uid);
      return exists(docRef) ? get(docRef).data.get('tenantId', null) : null;
    }

    function hasTenantAccess(tenantId) {
      return tenantId == null || (
        isSuperAdmin() 
        || (request.auth != null && getUserTenantId() == tenantId) 
        || (request.auth != null && getStaffTenantId() == tenantId)
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /staff/{staffId} {
      allow read, write: if request.auth != null;
    }

    match /tenants/{tenantId} {
      allow read: if true; 
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        isSuperAdmin()
        || resource.data.get('ownerEmail', '') == request.auth.token.email
        || resource.data.get('ownerUid', '') == request.auth.uid
        || hasTenantAccess(tenantId)
      );
    }

    match /businesses/{tenantId} {
      allow read: if true; 
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        isSuperAdmin()
        || resource.data.get('ownerEmail', '') == request.auth.token.email
        || resource.data.get('ownerUid', '') == request.auth.uid
        || hasTenantAccess(tenantId)
      );
    }

    match /branches/{branchId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    match /menu_items/{docId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    match /ads/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /landing_page_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /pricing_plans/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{docId} {
      allow read, write: if true;
    }

    match /reservations/{docId} {
      allow read, write: if true;
    }

    match /ingredients/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stock_movements/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tables/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /meal_subscription_plans/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /customer_subscriptions/{docId} {
      allow read, write: if true;
    }

    match /installed_extensions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /marketplace_extensions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /roles/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /permissions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /memberships/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /counters/{docId} {
      allow read, write: if true; 
    }
  }
}
