rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Explicitly deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to access required application collections for development
    match /users/{document=**} { allow read, write: if request.auth != null; }
    match /tenants/{document=**} { allow read, write: if request.auth != null; }
    match /businesses/{document=**} { allow read, write: if request.auth != null; }
    match /branches/{document=**} { allow read, write: if request.auth != null; }
    match /staff/{document=**} { allow read, write: if request.auth != null; }
    match /roles/{document=**} { allow read, write: if request.auth != null; }
    match /permissions/{document=**} { allow read, write: if request.auth != null; }
    match /orders/{document=**} { allow read, write: if request.auth != null; }
    match /menu_items/{document=**} { allow read, write: if request.auth != null; }
    match /reservations/{document=**} { allow read, write: if request.auth != null; }
    match /notifications/{document=**} { allow read, write: if request.auth != null; }
    match /ingredients/{document=**} { allow read, write: if request.auth != null; }
    match /stock_movements/{document=**} { allow read, write: if request.auth != null; }
    match /marketplace_extensions/{document=**} { allow read, write: if request.auth != null; }
    match /installed_extensions/{document=**} { allow read, write: if request.auth != null; }
    match /system_settings/{document=**} { allow read, write: if request.auth != null; }
    match /config/{document=**} { allow read, write: if request.auth != null; }
    match /counters/{document=**} { allow read, write: if request.auth != null; }
    
    // Additional collections extracted from AppContext.tsx
    match /categories/{document=**} { allow read, write: if request.auth != null; }
    match /tables/{document=**} { allow read, write: if request.auth != null; }
    match /stations/{document=**} { allow read, write: if request.auth != null; }
    match /ads/{document=**} { allow read, write: if request.auth != null; }
    match /pricing_plans/{document=**} { allow read, write: if request.auth != null; }
    match /meal_subscription_plans/{document=**} { allow read, write: if request.auth != null; }
    match /customer_subscriptions/{document=**} { allow read, write: if request.auth != null; }
    match /landing_page_settings/{document=**} { allow read, write: if request.auth != null; }
  }
}
