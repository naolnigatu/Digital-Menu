rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is super admin
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Function to get user's tenantId
    function getUserTenantId() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return user != null ? user.data.tenantId : null;
    }
    
    function getStaffTenantId() {
      let staff = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return staff != null ? staff.data.tenantId : null;
    }

    function hasTenantAccess(tenantId) {
      return isSuperAdmin() || getUserTenantId() == tenantId || getStaffTenantId() == tenantId;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.email == request.auth.token.email || hasTenantAccess(resource.data.tenantId) || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || hasTenantAccess(request.resource.data.tenantId) || isSuperAdmin());
    }

    match /staff/{staffId} {
      allow read: if request.auth != null && (request.auth.uid == staffId || resource.data.email == request.auth.token.email || hasTenantAccess(resource.data.tenantId) || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == staffId || hasTenantAccess(request.resource.data.tenantId) || isSuperAdmin());
    }

    match /tenants/{tenantId} {
      allow read: if true; // Public for landing pages & customer directory
      allow write: if request.auth != null && (hasTenantAccess(tenantId) || request.resource.data.ownerUid == request.auth.uid);
    }

    match /businesses/{tenantId} {
      allow read: if true; // Public
      allow write: if request.auth != null && (hasTenantAccess(tenantId) || request.resource.data.ownerUid == request.auth.uid);
    }

    match /branches/{branchId} {
      allow read: if true; // Public
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /categories/{docId} {
      allow read: if true; // Public menu
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /menu_items/{docId} {
      allow read: if true; // Public menu
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /ads/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (hasTenantAccess(request.resource.data.tenantId) || isSuperAdmin());
    }
    
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin();
    }
    
    match /landing_page_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin();
    }
    
    match /pricing_plans/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // Isolated collections - only accessible by tenant staff/owner
    match /orders/{docId} {
      allow read: if request.auth != null && (hasTenantAccess(resource.data.tenantId) || resource.data.customerId == request.auth.uid);
      allow write: if request.auth != null && (hasTenantAccess(request.resource.data.tenantId) || request.resource.data.customerId == request.auth.uid);
    }

    match /reservations/{docId} {
      allow read: if request.auth != null && (hasTenantAccess(resource.data.tenantId) || resource.data.customerId == request.auth.uid);
      allow write: if request.auth != null && (hasTenantAccess(request.resource.data.tenantId) || request.resource.data.customerId == request.auth.uid);
    }

    match /ingredients/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /stock_movements/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /notifications/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /tables/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /stations/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /meal_subscription_plans/{docId} {
      allow read: if true;
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }

    match /customer_subscriptions/{docId} {
      allow read: if request.auth != null && (hasTenantAccess(resource.data.tenantId) || resource.data.customerId == request.auth.uid);
      allow write: if request.auth != null && (hasTenantAccess(request.resource.data.tenantId) || request.resource.data.customerId == request.auth.uid);
    }

    match /installed_extensions/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }
    
    match /marketplace_extensions/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin();
    }
    
    match /roles/{docId} {
      allow read: if request.auth != null && hasTenantAccess(resource.data.tenantId);
      allow write: if request.auth != null && hasTenantAccess(request.resource.data.tenantId);
    }
    
    match /permissions/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || hasTenantAccess(resource.data.tenantId));
      allow write: if request.auth != null && (request.auth.uid == request.resource.data.userId || hasTenantAccess(request.resource.data.tenantId));
    }
    
    match /counters/{docId} {
      allow read, write: if request.auth != null; 
    }
  }
}
